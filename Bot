def format_money(x):
    try:
        return f"{int(x)} ₿"
    except:
        return "0 ₿"

def require_subscription(user_id):
    try:
        member = bot.get_chat_member(CHANNEL, user_id)
        return member.status in ["creator", "administrator", "member"]
    except Exception:
        return False

