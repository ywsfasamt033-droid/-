@bot.message_handler(func=lambda m: m.text == "📢 اذاعة")
def start_broadcast(m):
    if m.from_user.id != DEV_ID:
        return
    bot.reply_to(m, "📢 اكتب الرسالة التي تريد اذاعتها الآن:")
    bot.register_next_step_handler(m, do_broadcast)

def do_broadcast(m):
    if m.from_user.id != DEV_ID:
        return
    text = m.text
    sent = 0; failed = 0
    # نرسل لكل المستخدمين الذين لديهم حساب (عبر جميع الجروبات)
    for u in users_col.find({"has_account": True}):
        try:
            bot.send_message(int(u["user_id"]), f"📢 رسالة من المطور:\n\n{text}")
            sent += 1
        except:
            failed += 1
    bot.reply_to(m, f"✅ تم الإرسال إلى {sent} مستخدم. فشل عند {failed}.")

